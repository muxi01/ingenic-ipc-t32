enabled=1
label=config
offset=0x5600000
ops="13,6,1"
type=0

[sfc]
blocksize=32768
boot_quad=1
burn_quad=1
download_params=1
download_params_offset=0x6400
force_erase=1
reserve_partition=0
reserve_space=0
sfc_frequency=50000000

[spiPartition]
Partition0="uboot,0x0,0x200000,0,MTD_MODE"
Partition1="kernel_a,0x200000,0x500000,0,MTD_MODE"
Partition2="kernel_b,0x700000,0x500000,0,MTD_MODE"
Partition3="root_a,0xc00000,0x1400000,0,MTD_MODE"
Partition4="root_b,0x2000000,0x1400000,0,MTD_MODE"
Partition5="lullaby,0x3400000,0x2000000,0,MTD_MODE"
Partition6="info,0x5400000,0x100000,0,MTD_MODE"
Partition7="flag,0x5500000,0x80000,0,MTD_MODE"
Partition8="flag1,0x5580000,0x80000,0,MTD_MODE"
Partition9="config,0x5600000,0x8000000,0,MTD_MODE"
count=10

[ddr]
bank8=1
creator_version=1
cs0=1
cs1=0
current_ddr=M14D5121632A_DDR2.cfg
current_type="4,DDR2"
dw32=0

[debug]
boot_stage_send_length=1
cpu_info_length=8
log=1
read_back_chk=1
stage2_init_timeout=200
str_to_hex=-1
transfer_data_chk=1
transfer_size=65536
uart_burn_baudrate=921600
uart_transfer_size=32768

[gpio]
config="-1,-1,0,"

[info]
baud_rate=115200
complete=0
count=13
cpu_and_ddr_freq_limit_index=0
cpufreq=800000000
ddrfreq=200000000
extal=24000000
force_reset=0
power_off=0
sync_time=0
uart_gpio=1

[policy]
policy_count=10

[policy0]
attribute=/home/xialixin/ipc/images/mtds/mtds_nanddump/mtd0_uboot.bin
enabled=1
label=uboot
offset=0x0
ops="13,6,1"
type=0

[policy1]
attribute=/home/xialixin/ipc/images/mtds/mtds_nanddump/mtd1_kernel.bin
enabled=1
label=kernel_a
offset=0x200000
ops="13,6,1"
type=0

[policy2]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd1-kernel.bin
enabled=1
label=kernel_b
offset=0x700000
ops="13,6,1"
type=0

[policy3]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd3-rootfs.bin
enabled=1
label=root_a
offset=0xc00000
ops="13,6,1"
type=0

[policy4]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd4-rootfs.bin
enabled=1
label=root_b
offset=0x2000000
ops="13,6,1"
type=0

[policy5]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd5-lullaby.bin
enabled=1
label=lullaby
offset=0x3400000
ops="13,6,1"
type=0

[policy6]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd6-info.bin
enabled=1
label=info
offset=0x5400000
ops="13,6,1"
type=0

[policy7]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd7-flag.bin
enabled=1
label=flag
offset=0x5500000
ops="13,6,1"
type=0

[policy8]
attribute=/home/xialixin/ipc/images/mtds/mtds_cat_tail/mtd8-flag.bin
enabled=1
label=flag1
offset=0x5580000
ops="13,6,1"
type=0

[policy9]
